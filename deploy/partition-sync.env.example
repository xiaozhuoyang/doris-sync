# Copy this file and replace every value before installation.
# The installer stores it as /etc/doris-partition-sync/partition-sync.env (0640).
SOURCE_PASSWORD=replace_me
TARGET_PASSWORD=replace_me
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
SYNC_MODE=overwrite
# For time-window or static hourly-window, set this to a DATE/DATETIME column.
# Leave it unset when partition-sync.json has managedTasks=true.
# TIME_FIELD=event_time
